# Supabase project URL and anon (public) key.
# The anon key is public by design and safe in the client bundle; row-level
# security in Postgres is what protects the data. Never put a service_role
# key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployed URL, used by `npm run qr` to generate the print flyer QR code.
VITE_PUBLIC_URL=https://quick-connect-la.vercel.app
